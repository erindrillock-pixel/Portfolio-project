    "scoring = [\"recall\", \"precision\", \"f1\", \"roc_auc\", \"accuracy\"]\n",
    "\n",
    "baselines = {\n",
    "    \"Majority class (baseline)\": DummyClassifier(strategy=\"most_frequent\"),\n",
    "    \"Stratified random (reference)\": DummyClassifier(strategy=\"stratified\", random_state=RANDOM_STATE),\n",
    "}\n",
    "\n",
    "rows = {}\n",
    "for name, model in baselines.items():\n",
    "    pipe = Pipeline([(\"preprocess\", make_preprocessor()), (\"model\", model)])\n",
    "    scores = cross_validate(pipe, X_train, y_train, cv=cv, scoring=scoring)\n",
    "    rows[name] = {m: f\"{scores['test_' + m].mean():.3f} ± {scores['test_' + m].std():.3f}\" for m in scoring}\n",
    "\n",
    "baseline_results = pd.DataFrame(rows).T\n",
    "baseline_results.to_csv(RESULTS_DIR / \"baseline_cv_results.csv\")\n",
