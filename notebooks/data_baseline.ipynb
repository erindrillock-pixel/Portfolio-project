    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.dummy import DummyClassifier\n",
    "from sklearn.model_selection import StratifiedKFold, cross_validate, train_test_split\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import OneHotEncoder\n",
    "\n",
    "# Make the project's src/ folder importable when running from notebooks/\n",
    "PROJECT_ROOT = Path.cwd().resolve().parent if Path.cwd().name == \"notebooks\" else Path.cwd().resolve()\n",
    "sys.path.insert(0, str(PROJECT_ROOT))\n",
    "from src.data import FEATURE_NAMES, TARGET_NAME, load_dataset\n",
    "\n",
    "RANDOM_STATE = 42          # fixed seed so every split and result is reproducible\n",
    "TEST_SIZE = 0.20\n",
    "N_FOLDS = 5\n",
    "FIG_DIR = PROJECT_ROOT / \"reports\" / \"figures\"\n",
    "FIG_DIR.mkdir(parents=True, exist_ok=True)\n",
    "RESULTS_DIR = PROJECT_ROOT / \"reports\"\n",
    "\n",
    "pd.set_option(\"display.max_columns\", 40)\n",
    "print(\"Python\", sys.version.split()[0])"
   ]
