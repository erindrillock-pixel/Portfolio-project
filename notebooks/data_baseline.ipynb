   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "cc91c1cc",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-29T13:08:37.236610Z",
     "iopub.status.busy": "2026-10-29T13:08:37.236483Z",
     "iopub.status.idle": "2026-10-29T13:08:37.284361Z",
     "shell.execute_reply": "2026-10-29T13:08:37.283789Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Exact duplicate rows (features + label):  5,206 (47.1% of rows)\n",
      "Rows with a repeated feature pattern:     5,270\n",
      "Feature patterns with conflicting labels: 64 patterns, 357 rows\n",
      "Unique rows after dropping exact dups:    5,849\n"
     ]
    }
   ],
   "source": [
    "n_exact_dups = raw.duplicated().sum()\n",
    "n_feature_dups = raw[FEATURE_NAMES].duplicated().sum()\n",
    "\n",
    "# Feature patterns that appear with BOTH labels (identical inputs, different answers)\n",
    "label_counts = raw.groupby(FEATURE_NAMES)[TARGET_NAME].nunique()\n",
    "conflicting_patterns = label_counts[label_counts > 1]\n",
    "conflict_mask = raw.set_index(FEATURE_NAMES).index.isin(conflicting_patterns.index)\n",
    "\n",
    "print(f\"Exact duplicate rows (features + label):  {n_exact_dups:,} ({n_exact_dups / len(raw):.1%} of rows)\")\n",
    "print(f\"Rows with a repeated feature pattern:     {n_feature_dups:,}\")\n",
    "print(f\"Feature patterns with conflicting labels: {len(conflicting_patterns)} patterns, {conflict_mask.sum()} rows\")\n",
    "print(f\"Unique rows after dropping exact dups:    {len(raw) - n_exact_dups:,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "eb9aa039",
   "metadata": {},
   "source": [
    "This is the most important finding of the audit. Almost **half the rows are exact copies** of another row. With only\n",
    "30 coded features, two different websites *can* genuinely share the same pattern, so the duplicates are not necessarily\n",
    "data-entry errors. But for evaluation they are a problem: if a row and its copy end up on opposite sides of the\n",
    "train/test split, the model is tested on examples it has effectively already seen, which inflates the scores\n",
    "(**data leakage**). The next cell measures how big that effect would be with a naive split.\n",
    "\n",
    "There are also a small number of patterns that appear with **both** labels. No model can get all of these right,\n",
    "so they set a small ceiling on achievable accuracy (label noise / irreducible error)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "6822a00d",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-29T13:08:37.286045Z",
     "iopub.status.busy": "2026-10-29T13:08:37.285909Z",
     "iopub.status.idle": "2026-10-29T13:08:37.340667Z",
     "shell.execute_reply": "2026-10-29T13:08:37.340173Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Naive split: 65.5% of test rows also appear, identically, in the training set\n"
     ]
    }
   ],
   "source": [
    "# How much leakage would a naive split of the raw data cause?\n",
    "naive_train, naive_test = train_test_split(\n",
    "    raw, test_size=TEST_SIZE, stratify=raw[TARGET_NAME], random_state=RANDOM_STATE\n",
    ")\n",
    "train_rows = set(map(tuple, naive_train.to_numpy()))\n",
    "seen = np.array([tuple(r) in train_rows for r in naive_test.to_numpy()])\n",
    "print(f\"Naive split: {seen.mean():.1%} of test rows also appear, identically, in the training set\")"
   ]
  },
